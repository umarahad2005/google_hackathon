<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy.

  This file is merged over src/main for DEBUG builds only. It permits
  cleartext HTTP to any host so you can point the app at a backend on
  your PC's LAN IP (e.g. http://192.168.1.x:8000) when testing on a
  physical device. Release builds do NOT use this file — they fall back
  to the secure HTTPS-only policy in src/main/res/xml/.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
