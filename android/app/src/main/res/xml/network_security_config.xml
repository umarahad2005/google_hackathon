<?xml version="1.0" encoding="utf-8"?>
<!--
  Release / production network policy.

  HTTPS is required for all traffic (FastAPI Cloud serves HTTPS), so the
  app stays secure in production. Cleartext HTTP is permitted ONLY for the
  Android-emulator-to-host loopback addresses, so a local `fastapi dev`
  backend still works even in a release build run on the emulator.

  Debug builds use a more permissive override (see src/debug/res/xml/).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
