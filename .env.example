# ===================================================================
# Zimma AI — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ===================================================================

# --- Gemini (AI/LLM) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Google Maps Platform ---
GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# --- Supabase ---
SUPABASE_URL=https://musrkpxcsiytpyrjcnqn.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- App Config ---
APP_ENV=development
# Demo clock compression: 1 real second = N simulated minutes
# Set >1 for demo recordings so follow-up lifecycle plays fast
DEMO_CLOCK_MULTIPLIER=60
# Backend host/port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
